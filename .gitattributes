# Linjeskift normaliseres til LF i repoet, uanset hvad den enkelte maskine
# checker ud med. Uden dette gav et skift mellem VS Code paa Windows og
# byggescripterne en diff paa HELE filen, hvor kun faa linjer var aendret.
* text=auto eol=lf

# Genererede Power Apps-kilder. De skrives altid af byggescripterne med LF.
*.pa.yaml text eol=lf
*.py      text eol=lf

# PowerShell koeres paa Windows.
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# VBA-moduler importeres i Excel paa Windows, og seed-CSV'er laeses af
# PowerShell samme sted. Repoet gemmer dem med LF som alt andet - kun
# checkouten faar CRLF.
*.bas     text eol=crlf
*.csv     text eol=crlf

# Binaert - maa ikke roeres.
*.xlsx    binary
*.xlsm    binary
*.msapp   binary
*.frx     binary
*.db      binary
*.png     binary
*.jpg     binary
*.pdf     binary

# Testfakturaerne (docs/34): byte for byte, som fakturalaeseren skal se dem.
# En faktura i ISO-8859-1 eller med CR i en PDF-stroem maa ikke "rettes".
tools/invoice/fixtures/** binary
