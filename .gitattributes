# Linjeskift normaliseres til LF i repoet, uanset hvad den enkelte maskine
# checker ud med. Uden dette gav et skift mellem VS Code paa Windows og
# byggescripterne en diff paa HELE filen, hvor kun faa linjer var aendret.
* text=auto eol=lf

# Genererede Power Apps-kilder. De skrives altid af byggescripterne med LF.
*.pa.yaml text eol=lf
*.py      text eol=lf

# PowerShell koeres paa Windows.
*.ps1     text eol=crlf

# Binaert - maa ikke roeres.
*.xlsx    binary
*.png     binary
*.jpg     binary
