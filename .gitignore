__pycache__/
*.pyc

# Arbejdsmapper for tools/canvas_mcp.py - serverens tilstand, ikke kilder.
.canvas-deploy/
.canvas-sync/

# Excel-laasefiler. De opstaar, naar en projektmappe er aaben, og hoerer
# ikke til i git.
~$*

# Solution-eksport. Flows, miljoevariabel-DEFINITIONER og connection
# references committes - de er laesestof om, hvad appen taler med.
# Binaerer og variablernes VAERDIER goer ikke; vaerdierne hoerer til
# miljoeet og er der, en hemmelighed ender. tools/scrub_solution.py
# fjerner dem ogsaa, men to spaerringer er bedre end een.
solution/**/*.msapp
solution/**/*.zip
solution/**/environmentvariablevalues/
solution/**/obj/
solution/**/bin/

# Tilstand fra kodeagenter (Copilot-sessioner). events.jsonl bar lokale
# stier, e-mailadresser og make.powerapps.com-URL'er - intet af det er
# kilde, og intet i repoet laeser filerne.
events.jsonl
session.db
workspace.yaml
checkpoints/

# Udfasede enkeltapps (docs/33-udfasning.md): BIO SAP App er den app, der
# bruges. Deres App.pa.yaml skrives som mellemprodukt af BIO SAP's
# generate_app.py og hoerer ikke i git.
/Masterdata Hub/*.pa.yaml
/Maintenance Plan App/*.pa.yaml
/Equipment App/*.pa.yaml
/Material App/*.pa.yaml
/Functional Location App/*.pa.yaml
# KKS-opslaget har aldrig vaeret en enkeltapp: det bygges kun som skaerm i
# BIO SAP, og KKS App/*.pa.yaml er mellemprodukter paa samme maade.
/KKS App/*.pa.yaml

# VH-plan Opretter bygges af excel/opretter/Build-Opretter.ps1 ud af
# .bas-filerne. Projektmappen er et produkt, ikke kilde.
/excel/opretter/*.xlsm
# Issue Board (issue #114) bygges ligesom KKS kun som skaerm i BIO SAP.
/Issue Board/*.pa.yaml
# Measuring Point (issue #210) har aldrig vaeret en enkeltapp - den bygges
# kun som skaerm i BIO SAP, og mappens *.pa.yaml er mellemprodukter.
/Measuring Point App/*.pa.yaml
