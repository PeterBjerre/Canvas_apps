{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapOutlookConn"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapSharePointConn"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "BioSap-SiteUrl (orsted_BioSapSiteUrl)": {
          "defaultValue": "https://orsted.sharepoint.com/teams/BioSAPDev",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSiteUrl"
          }
        },
        "BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)": {
          "defaultValue": "55c96ba9-52b8-4018-8945-f736b001d6a2",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenancePlans"
          }
        },
        "BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)": {
          "defaultValue": "pkbje@orsted.com",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapErrorNotifiers"
          }
        },
        "BioSap-ListItemEntityTypeMaintenancePlan (orsted_BioSapListItemEntityTypeMaintenancePlan)": {
          "defaultValue": "SP.Data.MaintenancePlansListItem",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListItemEntityTypeMaintenancePlan"
          }
        },
        "BioSap-List-MaintenancePlansName (orsted_BioSapListMaintenancePlansName)": {
          "defaultValue": "MaintenancePlans",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenancePlansName"
          }
        },
        "MD_RequestIndex (orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7)": {
          "defaultValue": "3d945b5b-bd5b-43eb-be27-3f0c2416b08a",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7"
          }
        },
        "BioSap-List-MaintenanceItems (orsted_BioSapListMaintenanceItems)": {
          "defaultValue": "d0b2538e-c702-4375-b766-caf342259495",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenanceItems"
          }
        },
        "BioSap-List-TaskListMain (orsted_BioSapListTaskListMain)": {
          "defaultValue": "c01b8d71-a304-4d5c-a84a-4644b87f8f28",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListTaskListMain"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created_or_modified": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "775e5c8b-5281-4a74-bd22-33d5f9d97dcd"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
              "table": "@parameters('BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@equals(triggerBody()?['Status/Value'],'In Progress')"
            },
            {
              "expression": "@equals(triggerBody()?['InitialEmailSent'], false)"
            }
          ]
        }
      },
      "actions": {
        "Catch": {
          "actions": {
            "Convert_UTC_time_to_DK_time_zone": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "a5a8c8b3-3418-4a96-9c0b-3190061c1d11"
              },
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@utcNow()",
                "formatString": "G",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "Romance Standard Time"
              }
            },
            "Send_notification_to_development_team": {
              "runAfter": {
                "Convert_UTC_time_to_DK_time_zone": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d7e649b4-8625-486f-a8a2-9f8c573a8faf"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                  "emailMessage/Subject": "An error occured in the flow - @{workflow()?['tags']?['flowDisplayName']}",
                  "emailMessage/Body": "<p><span style=\"font-family: arial\">Hi,<br>\n<br>\nAn error was detected in the following flow instance.<br>\n<br>\n&gt;Timestamp<br>\n</span><span style=\"font-family: arial\">@{body('Convert_UTC_time_to_DK_time_zone')}</span><span style=\"font-family: arial\"><br>\n<br>\n<br>\n&gt;Run History<br>\n</span><span style=\"font-family: arial\">@{variables('FlowRunHistoryLink')}</span><span style=\"font-family: arial\"><br>\n<br>\nPlease assign to yourself if you are looking into the issue. Kindly update the resolution for future referrence.<br>\n<br>\n<br>\nThank you</span></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "8dbbeab7-f423-4f3b-81f7-794829653c14"
          },
          "type": "Scope"
        },
        "Initialize_FlowRunHistoryLink": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e4d34a34-38aa-4d80-a349-ecf80844b24a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FlowRunHistoryLink",
                "type": "string",
                "value": "<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}\">Link to Run History</a>"
              }
            ]
          },
          "description": "Holds the hyperlink to current run of the flow. Used in error notification"
        },
        "Try": {
          "actions": {
            "Send_an_email_(V2)-EmailRequestor": {
              "runAfter": {
                "Compose-EmailContent": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "c4d6631f-d48b-4bcd-b358-95d40ca64fde"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['Author/Email']",
                  "emailMessage/Subject": "@concat('VH-plan ', triggerBody()?['PlanID'], ' sendt til godkendelse - ', coalesce(triggerBody()?['PlantsInitial/Value'], ''))",
                  "emailMessage/Body": "@outputs('Compose-EmailContent')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Compose-EmailContent": {
              "runAfter": {
                "Total_work": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "0181ec1c-0ad8-4b87-8b1f-9c205555c50e"
              },
              "type": "Compose",
              "inputs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n       style=\"margin:0;padding:0;background-color:#eef2f6;\"><tr><td align=\"center\" style=\"padding:24px 12px;\"><div style=\"display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#eef2f6;\">\n        @{replace(replace(replace(coalesce(triggerBody()?['PlantsInitial/Value'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')} &middot; @{length(outputs('Get_items_MaintenanceItems')?['body/value'])} item(s) &middot; @{replace(replace(replace(coalesce(triggerBody()?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\n      </div><table role=\"presentation\" width=\"640\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n             style=\"width:640px;max-width:640px;background-color:#ffffff;\n                    border:1px solid #d7dee8;font-family:Segoe UI,Arial,Helvetica,sans-serif;\"><tr><td style=\"background-color:#12405f;padding:20px 24px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"font-size:12px;letter-spacing:.08em;text-transform:uppercase;\n                           color:#8fc4e5;padding-bottom:4px;\">\n                  Sendt til godkendelse\n                </td></tr><tr><td style=\"font-size:26px;font-weight:600;color:#ffffff;line-height:1.2;\">\n                  @{replace(replace(replace(triggerBody()?['PlanID'], '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\n                </td></tr><tr><td style=\"font-size:15px;color:#d6e6f2;padding-top:6px;line-height:1.4;\">\n                  @{replace(replace(replace(coalesce(triggerBody()?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\n                </td></tr></table></td></tr><tr><td style=\"padding:18px 24px 18px 24px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"background-color:#e8f1f8;border-left:4px solid #1a6ea8;padding:12px 16px;font-size:14px;color:#24313f;line-height:1.5;\"><div style=\"font-weight:600;color:#12405f;padding-bottom:4px;\">Planen er sendt til godkendelse</div>Du får besked, når planen er godkendt eller sendt retur.</td></tr></table></td></tr><tr><td style=\"padding:0;border-bottom:1px solid #e4e9f0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td width=\"33%\" align=\"center\" style=\"padding:16px 8px;border-right:1px solid #e4e9f0;\"><div style=\"font-size:22px;font-weight:600;color:#12405f;\">@{replace(replace(replace(coalesce(triggerBody()?['PlantsInitial/Value'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</div><div style=\"font-size:11px;color:#6b7b8c;text-transform:uppercase;letter-spacing:.06em;padding-top:2px;\">Værk</div></td><td width=\"33%\" align=\"center\" style=\"padding:16px 8px;border-right:1px solid #e4e9f0;\"><div style=\"font-size:22px;font-weight:600;color:#12405f;\">@{length(outputs('Get_items_MaintenanceItems')?['body/value'])}</div><div style=\"font-size:11px;color:#6b7b8c;text-transform:uppercase;letter-spacing:.06em;padding-top:2px;\">Items</div></td><td width=\"34%\" align=\"center\" style=\"padding:16px 8px;\"><div style=\"font-size:22px;font-weight:600;color:#12405f;\">@{triggerBody()?['Cycle']} @{replace(replace(replace(coalesce(triggerBody()?['Unit/Value'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</div><div style=\"font-size:11px;color:#6b7b8c;text-transform:uppercase;letter-spacing:.06em;padding-top:2px;\">Cyklus</div></td></tr></table></td></tr><tr><td style=\"padding:22px 24px 6px 24px;\"><div style=\"font-size:13px;font-weight:600;color:#12405f;text-transform:uppercase;\n                        letter-spacing:.06em;padding-bottom:10px;\">Planen</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                   style=\"font-size:14px;color:#24313f;\"><tr><td width=\"42%\" style=\"padding:7px 0;color:#6b7b8c;border-bottom:1px solid #eef2f6;\">Status</td><td style=\"padding:7px 0;border-bottom:1px solid #eef2f6;font-weight:600;\">@{if(equals(triggerBody()?['Status/Value'], 'Returned'), 'Sendt retur', if(equals(triggerBody()?['Status/Value'], 'Published'), 'Oprettet i SAP', if(equals(triggerBody()?['Status/Value'], 'Ready for creation in SAP'), 'Klar til oprettelse i SAP', if(equals(triggerBody()?['Status/Value'], 'In Progress'), concat('Til godkendelse - ', if(equals(triggerBody()?['ApprovalStage/Value'], 'System'), 'system', if(equals(triggerBody()?['ApprovalStage/Value'], 'Cost'), 'omkostning', 'kvalitet'))), 'Kladde'))))}</td></tr><tr><td style=\"padding:7px 0;color:#6b7b8c;border-bottom:1px solid #eef2f6;\">Strategi</td><td style=\"padding:7px 0;border-bottom:1px solid #eef2f6;\">@{replace(replace(replace(coalesce(triggerBody()?['StrategyKey'], '-'), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:7px 0;color:#6b7b8c;border-bottom:1px solid #eef2f6;\">Første planlagte kald</td><td style=\"padding:7px 0;border-bottom:1px solid #eef2f6;\">@{formatDateTime(triggerBody()?['PlannedDate'], 'dd-MM-yyyy')}</td></tr><tr><td style=\"padding:7px 0;color:#6b7b8c;border-bottom:1px solid #eef2f6;\">Scheduling period</td><td style=\"padding:7px 0;border-bottom:1px solid #eef2f6;\">@{coalesce(triggerBody()?['SchedulingPeriod'], '-')} år</td></tr><tr><td style=\"padding:7px 0;color:#6b7b8c;border-bottom:1px solid #eef2f6;\">Sort field</td><td style=\"padding:7px 0;border-bottom:1px solid #eef2f6;\">@{replace(replace(replace(coalesce(triggerBody()?['SortField/Value'], '-'), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:7px 0;color:#6b7b8c;\">Indmeldt af</td><td style=\"padding:7px 0;\">@{replace(replace(replace(coalesce(first(outputs('Get_AppUrl_based_on_environment')?['body/value'])?['RequesterName'], triggerBody()?['Author/DisplayName']), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')} &middot;\n                  <a href=\"mailto:@{replace(replace(replace(coalesce(first(outputs('Get_AppUrl_based_on_environment')?['body/value'])?['RequesterEmail'], triggerBody()?['Author/Email']), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\" style=\"color:#1a6ea8;text-decoration:none;\">@{replace(replace(replace(coalesce(first(outputs('Get_AppUrl_based_on_environment')?['body/value'])?['RequesterEmail'], triggerBody()?['Author/Email']), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</a></td></tr></table></td></tr><tr><td style=\"padding:22px 24px 6px 24px;\"><div style=\"font-size:13px;font-weight:600;color:#12405f;text-transform:uppercase;\n                        letter-spacing:.06em;padding-bottom:10px;\">\n              Items (@{length(outputs('Get_items_MaintenanceItems')?['body/value'])})\n            </div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                   style=\"border-collapse:collapse;font-size:13px;color:#24313f;\"><tr style=\"background-color:#f4f7fa;\"><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Item</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Kort tekst</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Funktionsplads</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Akt.type</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Arb.center</th></tr>\n              @{join(body('Select_item_rows'), '')}\n            </table></td></tr><tr><td style=\"padding:22px 24px 6px 24px;\"><div style=\"font-size:13px;font-weight:600;color:#12405f;text-transform:uppercase;\n                        letter-spacing:.06em;padding-bottom:10px;\">\n              Operationer (@{length(outputs('Get_items_TaskListMain')?['body/value'])}) &middot; @{outputs('Total_work')} timer i alt\n            </div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                   style=\"border-collapse:collapse;font-size:13px;color:#24313f;\"><tr style=\"background-color:#f4f7fa;\"><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Op.</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Tekst</th><th align=\"left\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                        font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                        color:#6b7b8c;font-weight:600;\">Arb.center</th><th align=\"right\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                         font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                         color:#6b7b8c;font-weight:600;\">Work</th><th align=\"right\" style=\"padding:8px 8px;border-bottom:2px solid #d7dee8;\n                                         font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n                                         color:#6b7b8c;font-weight:600;\">Varighed</th></tr>\n              @{join(body('Select_op_rows'), '')}\n            </table></td></tr><tr><td align=\"center\" style=\"padding:26px 24px 8px 24px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"#1a6ea8\" style=\"padding:12px 28px;\"><a href=\"@{variables('EditLink')}\" target=\"_blank\"\n                     style=\"font-family:Segoe UI,Arial,Helvetica,sans-serif;font-size:15px;\n                            font-weight:600;color:#ffffff;text-decoration:none;display:inline-block;\">\n                    Åbn planen i appen\n                  </a></td></tr></table></td></tr><tr><td style=\"padding:16px 24px 22px 24px;border-top:1px solid #e4e9f0;\n                     font-size:12px;color:#8494a5;line-height:1.6;\">\n            Indmelding <strong style=\"color:#6b7b8c;\">@{replace(replace(replace(coalesce(first(outputs('Get_AppUrl_based_on_environment')?['body/value'])?['Title'], triggerBody()?['PlanID']), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</strong> &middot;\n            sendt @{formatDateTime(coalesce(first(outputs('Get_AppUrl_based_on_environment')?['body/value'])?['LastActionOn'], utcNow()), 'dd-MM-yyyy HH:mm')}.<br>\n            Denne mail er sendt automatisk af VH-plan appen. Svar på den når ikke nogen -\n            skriv til <a href=\"mailto:sapvedligehold@orsted.com\" style=\"color:#1a6ea8;text-decoration:none;\">sapvedligehold@orsted.com</a>.\n          </td></tr></table></td></tr></table>"
            },
            "Set_App_Url_and_Edit_Link": {
              "actions": {
                "Get_AppUrl_based_on_environment": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "1021f5e3-97da-4593-a3b7-7068aa33e45a"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                      "table": "@parameters('MD_RequestIndex (orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7)')",
                      "$filter": "SourceItemId eq @{triggerOutputs()?['body/ID']} and Domain eq 'MaintenancePlan'",
                      "$top": 1
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Set_the_App_Url_": {
                  "foreach": "@outputs('Get_AppUrl_based_on_environment')?['body/value']",
                  "actions": {
                    "Set_variable-_EditLink": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "e42cb9c3-f1b6-4d62-890b-17a88a7607e8"
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "EditLink",
                        "value": "@items('Set_the_App_Url_')?['AppUrl']"
                      }
                    }
                  },
                  "runAfter": {
                    "Get_AppUrl_based_on_environment": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "82d84e6d-c98a-4de0-bd8f-4cfa8f09f944"
                  },
                  "type": "Foreach"
                },
                "Set_variable-_AppUrl": {
                  "runAfter": {
                    "Set_the_App_Url_": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "b1f9c18f-cd29-4f3c-a1dc-3a40260008f3"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "AppUrl",
                    "value": "<a href=\"@{variables('EditLink')}\">here</a>"
                  }
                }
              },
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "c6a86387-d20d-411f-9364-4742d6c76984"
              },
              "type": "Scope"
            },
            "Send_an_HTTP_request_to_SharePoint": {
              "runAfter": {
                "Send_an_email_(V2)-EmailRequestor": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "558ad703-83a3-4d0f-b899-cfb70f3142c0"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/GetByTitle('@{parameters('BioSap-List-MaintenancePlansName (orsted_BioSapListMaintenancePlansName)')}')/items(@{triggerOutputs()?['body/ID']})",
                  "parameters/headers": {
                    "Content-Type": "application/json;odata=verbose",
                    "If-Match": "*",
