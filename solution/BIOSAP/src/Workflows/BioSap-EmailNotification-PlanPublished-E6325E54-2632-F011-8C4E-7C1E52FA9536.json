{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapOutlookConn"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapSharePointConn"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "BioSap-SiteUrl (orsted_BioSapSiteUrl)": {
          "defaultValue": "https://orsted.sharepoint.com/teams/BioSAPDev",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSiteUrl"
          }
        },
        "BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)": {
          "defaultValue": "thasi@orsted.com",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapErrorNotifiers"
          }
        },
        "BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)": {
          "defaultValue": "55c96ba9-52b8-4018-8945-f736b001d6a2",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenancePlans"
          }
        },
        "BioSap-List-MaintenancePlansName (orsted_BioSapListMaintenancePlansName)": {
          "defaultValue": "MaintenancePlans",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenancePlansName"
          }
        },
        "BioSap-ListItemEntityTypeMaintenancePlan (orsted_BioSapListItemEntityTypeMaintenancePlan)": {
          "defaultValue": "SP.Data.MaintenancePlansListItem",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListItemEntityTypeMaintenancePlan"
          }
        },
        "MD_ApprovalLog (orsted_shared_sharepointonline_ec07acb417e14a7c999704263844acb9)": {
          "defaultValue": "f80b05d7-06f9-4cf5-b6a7-45ed8a3c4ee3",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_shared_sharepointonline_ec07acb417e14a7c999704263844acb9"
          }
        },
        "MD_RequestIndex (orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7)": {
          "defaultValue": "3d945b5b-bd5b-43eb-be27-3f0c2416b08a",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created_or_modified": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "565c649b-4edb-43b3-9160-563b3cf366dd"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline-1",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
              "table": "@parameters('BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@equals(triggerBody()?['Status/Value'],'Published')"
            },
            {
              "expression": "@not(empty(triggerBody()?['SAPNum']))"
            },
            {
              "expression": "@not(equals(triggerBody()?['RequesterNotified'], true))"
            }
          ]
        }
      },
      "actions": {
        "Try": {
          "actions": {
            "Compose-EmailContent": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "0181ec1c-0ad8-4b87-8b1f-9c205555c50e"
              },
              "type": "Compose",
              "inputs": "<table style=\"width: 80%; font-family: Arial, Helvetica, sans-serif; border-collapse: collapse; border: 1px solid #ddd;\">\n  <tr style=\"background-color: #4099da; color: white;\">\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">Plan ID</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerOutputs()?['body/PlanID']}</td>\n  </tr>\n  <tr>\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">Title</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerBody()?['Title']}</td>\n  </tr>\n  <tr>\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">Sort Field</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerBody()?['SortField/Value']}</td>\n  </tr>\n  <tr>\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">Cycle</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerBody()?['Cycle']}</td>\n  </tr>\n  <tr>\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">Unit</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerBody()?['Unit/Value']}</td>\n  </tr>\n  <tr>\n    <th style=\"padding: 6px; text-align: left; border: 1px solid #ddd;\">First Planned Date</th>\n    <td style=\"padding: 6px; border: 1px solid #ddd;\">@{triggerBody()?['PlannedDate']}</td>\n  </tr>\n</table>"
            },
            "Send_an_email_(V2)-EmailRequestor": {
              "runAfter": {
                "Compose-EmailContent": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "c4d6631f-d48b-4bcd-b358-95d40ca64fde"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['Author/Email']",
                  "emailMessage/Subject": "Bio Sap: Maintenance Plan Published",
                  "emailMessage/Body": "<p style=\"font-family: Arial, sans-serif;\">Dear @{triggerBody()?['Author/DisplayName']},</p>\n\n<p style=\"font-family: Arial, sans-serif;\">\n  The maintenance plan below have been published:<br />\n  @{outputs('Compose-EmailContent')}\n</p>\n\n<p style=\"font-family: Arial, sans-serif;\">Thank you.</p>",
                  "emailMessage/Cc": "@triggerOutputs()?['body/Editor/Email']",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_requester_notified": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Send_an_email_(V2)-EmailRequestor": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline-1",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/GetByTitle('@{parameters('BioSap-List-MaintenancePlansName (orsted_BioSapListMaintenancePlansName)')}')/items(@{triggerBody()?['ID']})",
                  "parameters/headers": {
                    "Content-Type": "application/json;odata=verbose",
                    "If-Match": "*",
                    "X-HTTP-Method": "MERGE"
                  },
                  "parameters/body": "{\"__metadata\": {\"type\": \"@{parameters('BioSap-ListItemEntityTypeMaintenancePlan (orsted_BioSapListItemEntityTypeMaintenancePlan)')}\"}, \"RequesterNotified\": true}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_request_index": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Set_requester_notified": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline-1",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "table": "@parameters('MD_RequestIndex (orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7)')",
                  "$filter": "SourceItemId eq @{triggerBody()?['ID']} and Domain eq 'MaintenancePlan'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "RequestGuid": {
              "type": "Compose",
              "inputs": "@coalesce(first(outputs('Get_request_index')?['body/value'])?['RequestGuid'], '')",
              "runAfter": {
                "Get_request_index": [
                  "Succeeded"
                ]
              }
            },
            "Log_sap_created": {
              "type": "OpenApiConnection",
              "runAfter": {
                "RequestGuid": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline-1",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "table": "@parameters('MD_ApprovalLog (orsted_shared_sharepointonline_ec07acb417e14a7c999704263844acb9)')",
                  "item/Title": "@workflow()?['run']?['name']",
                  "item/RequestGuid": "@outputs('RequestGuid')",
                  "item/PlanId": "@triggerBody()?['ID']",
                  "item/Stage": "SapCreated",
                  "item/Decision": "Approve",
                  "item/DecidedByEmail": "system",
                  "item/DecidedOn": "@utcNow()",
                  "item/Detail": "@concat('SAP plan ', triggerBody()?['SAPNum'])"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Index_published": {
              "type": "If",
              "expression": {
                "greater": [
                  "@length(outputs('Get_request_index')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Patch_index_published": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline-1",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                      "table": "@parameters('MD_RequestIndex (orsted_shared_sharepointonline_9f0c6e07f15d4509a3ecab4d20b7fff7)')",
                      "id": "@first(outputs('Get_request_index')?['body/value'])?['ID']",
                      "item/Title": "@first(outputs('Get_request_index')?['body/value'])?['Title']",
                      "item/Domain": {
                        "Value": "MaintenancePlan"
                      },
                      "item/RequesterEmail": "@first(outputs('Get_request_index')?['body/value'])?['RequesterEmail']",
                      "item/Status": {
                        "Value": "OprettetISAP"
                      },
                      "item/StatusStep": 5,
                      "item/SapObjectNo": "@triggerBody()?['SAPNum']",
                      "item/IsOpen": false,
                      "item/LastActionBy": "SAP",
                      "item/LastActionOn": "@utcNow()"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {
                "Log_sap_created": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              }
            }
          },
          "runAfter": {
            "Initialize_FlowRunHistoryLink": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a5754edf-e160-490b-b94d-6400d08a6c93"
          },
          "type": "Scope"
        },
        "Catch": {
          "actions": {
            "Convert_UTC_time_to_DK_time_zone": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "a5a8c8b3-3418-4a96-9c0b-3190061c1d11"
              },
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@utcNow()",
                "formatString": "G",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "Romance Standard Time"
              }
            },
            "Send_notification_to_development_team": {
              "runAfter": {
                "Convert_UTC_time_to_DK_time_zone": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d7e649b4-8625-486f-a8a2-9f8c573a8faf"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                  "emailMessage/Subject": "An error occured in the flow - @{workflow()?['tags']?['flowDisplayName']}",
                  "emailMessage/Body": "<p><span style=\"font-family: arial\">Hi,<br>\n<br>\nAn error was detected in the following flow instance.<br>\n<br>\n&gt;Timestamp<br>\n</span><span style=\"font-family: arial\">@{body('Convert_UTC_time_to_DK_time_zone')}</span><span style=\"font-family: arial\"><br>\n<br>\n<br>\n&gt;Run History<br>\n</span><span style=\"font-family: arial\">@{variables('FlowRunHistoryLink')}</span><span style=\"font-family: arial\"><br>\n<br>\nPlease assign to yourself if you are looking into the issue. Kindly update the resolution for future referrence.<br>\n<br>\n<br>\nThank you</span></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "8dbbeab7-f423-4f3b-81f7-794829653c14"
          },
          "type": "Scope"
        },
        "Finally": {
          "actions": {},
          "runAfter": {
            "Catch": [
              "Succeeded",
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "bf5d15fa-c0f1-43a2-9e24-5b025017a813"
          },
          "type": "Scope"
        },
        "Initialize_FlowRunHistoryLink": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e4d34a34-38aa-4d80-a349-ecf80844b24a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FlowRunHistoryLink",
                "type": "string",
                "value": "<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}\">Link to Run History</a>"
              }
            ]
          },
          "description": "Holds the hyperlink to current run of the flow. Used in error notification"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}