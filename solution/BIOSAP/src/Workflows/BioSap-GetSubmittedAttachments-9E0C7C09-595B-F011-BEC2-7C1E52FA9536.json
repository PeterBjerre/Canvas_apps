{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapSharePointConn"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_sharepointonline_1": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapSharePointConn"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "invoker",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapOutlookConn"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "BioSap-SiteUrl (orsted_BioSapSiteUrl)": {
          "defaultValue": "https://orsted.sharepoint.com/teams/BioSAPDev",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSiteUrl"
          }
        },
        "BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)": {
          "defaultValue": "thasi@orsted.com",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapErrorNotifiers"
          }
        },
        "BioSap-Library-TaskListDocuments (orsted_BioSapLibraryTaskListDocuments)": {
          "defaultValue": "62349b00-5528-4124-9c6d-a07065d068d1",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapLibraryTaskListDocuments"
          }
        },
        "BioSap-SiteName (orsted_BioSapSiteName)": {
          "defaultValue": "BioSAPDev",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSiteName"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "0d02a772-2178-4ef0-9eac-08dc28ba4801"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "TaskListID",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Try": {
          "actions": {
            "Send_an_HTTP_request_to_SharePoint": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "558ad703-83a3-4d0f-b899-cfb70f3142c0"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/GetFolderByServerRelativeUrl('/teams/@{parameters('BioSap-SiteName (orsted_BioSapSiteName)')}/@{triggerBody()['text']}')",
                  "parameters/headers": {
                    "Accept": "application/json;odata=verbose"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              }
            },
            "Condition_2": {
              "actions": {
                "Get_files": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "23037ed5-94ef-4eb1-9baf-0a4a652d79cc"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline_1",
                      "operationId": "GetFileItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                      "table": "@parameters('BioSap-Library-TaskListDocuments (orsted_BioSapLibraryTaskListDocuments)')",
                      "folderPath": "@triggerBody()['text']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Select": {
                  "runAfter": {
                    "Get_files": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "327e79e7-2af5-4646-b9a8-c7e894fb1222"
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Get_files')?['value']",
                    "select": {
                      "Name": "@item()?['{FilenameWithExtension}']",
                      "Link": "@item()?['{Link}']",
                      "Identifier": "@item()?['{Identifier}']"
                    }
                  }
                },
                "Condition": {
                  "actions": {
                    "Respond_to_a_Power_App_or_flow": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "711affc5-b9bc-4992-a085-14c4c3e5a0f0"
                      },
                      "type": "Response",
                      "kind": "PowerApp",
                      "inputs": {
                        "statusCode": 200,
                        "body": {
                          "files": "@{body('Select')}"
                        },
                        "schema": {
                          "type": "object",
                          "properties": {
                            "files": {
                              "title": "files",
                              "x-ms-dynamically-added": true,
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Select": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {
                      "Respond_to_a_Power_App_or_flow_2": {
                        "runAfter": {},
                        "metadata": {
                          "operationMetadataId": "9d87ac80-ab4c-40bd-83b1-55b1d1a297f3"
                        },
                        "type": "Response",
                        "kind": "PowerApp",
                        "inputs": {
                          "statusCode": 200,
                          "body": {
                            "files": "[]"
                          },
                          "schema": {
                            "type": "object",
                            "properties": {
                              "files": {
                                "title": "files",
                                "x-ms-dynamically-added": true,
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "expression": {
                    "greater": [
                      "@length(body('Select'))",
                      0
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "1c74e16d-7992-474c-a841-b551007bf718"
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Send_an_HTTP_request_to_SharePoint": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "else": {
                "actions": {
                  "Respond_to_a_Power_App_or_flow_3": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "8e1c1d72-1af8-4bd0-bea0-0b5419af4a08"
                    },
                    "type": "Response",
                    "kind": "PowerApp",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "files": "[]"
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "files": {
                            "title": "files",
                            "x-ms-dynamically-added": true,
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "expression": {
                "equals": [
                  "@outputs('Send_an_HTTP_request_to_SharePoint')?['statusCode']",
                  200
                ]
              },
              "metadata": {
                "operationMetadataId": "92aabad1-d21a-4965-aded-757ff101617b"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Initialize_FlowRunHistoryLink": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "032dce8c-da38-4d30-b5f4-ef8b20440acd"
          },
          "type": "Scope"
        },
        "Catch": {
          "actions": {
            "Convert_UTC_time_to_DK_time_zone": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "a5a8c8b3-3418-4a96-9c0b-3190061c1d11"
              },
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@utcNow()",
                "formatString": "G",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "Romance Standard Time"
              }
            },
            "Send_notification_to_development_team": {
              "runAfter": {
                "Convert_UTC_time_to_DK_time_zone": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d7e649b4-8625-486f-a8a2-9f8c573a8faf"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                  "emailMessage/Subject": "An error occured in the flow - @{workflow()?['tags']?['flowDisplayName']}",
                  "emailMessage/Body": "<p><span style=\"font-family: arial\">Hi,<br>\n<br>\nAn error was detected in the following flow instance.<br>\n<br>\n&gt;Timestamp<br>\n</span><span style=\"font-family: arial\">@{body('Convert_UTC_time_to_DK_time_zone')}</span><span style=\"font-family: arial\"><br>\n<br>\n<br>\n&gt;Run History<br>\n</span><span style=\"font-family: arial\">@{variables('FlowRunHistoryLink')}</span><span style=\"font-family: arial\"><br>\n<br>\nPlease assign to yourself if you are looking into the issue. Kindly update the resolution for future referrence.<br>\n<br>\n<br>\nThank you</span></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "33db3040-6ea8-4ea4-b3c5-383b598b2d08"
          },
          "type": "Scope"
        },
        "Finally": {
          "actions": {},
          "runAfter": {
            "Catch": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "2e0cd4e2-4b52-4015-a7cd-75ff124165e3"
          },
          "type": "Scope"
        },
        "Initialize_FlowRunHistoryLink": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "e4d34a34-38aa-4d80-a349-ecf80844b24a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FlowRunHistoryLink",
                "type": "string",
                "value": "<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}\">Link to Run History</a>"
              }
            ]
          },
          "description": "Holds the hyperlink to current run of the flow. Used in error notification"
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}