            },
            "For_each_SearchChar": {
              "foreach": "@chunk(variables('SearchRemainder'),1)",
              "actions": {
                "Append_to_string_variable_SearchHex": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "65ae8488-3651-493f-b97b-5cedbb6a4bfd"
                  },
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "SearchHex",
                    "value": "@if(equals(item(),'0'),'30',if(equals(item(),'1'),'31',if(equals(item(),'2'),'32',if(equals(item(),'3'),'33',if(equals(item(),'4'),'34',if(equals(item(),'5'),'35',if(equals(item(),'6'),'36',if(equals(item(),'7'),'37',if(equals(item(),'8'),'38',if(equals(item(),'9'),'39',if(equals(item(),' '),'20',if(equals(item(),'A'),'41',if(equals(item(),'B'),'42',if(equals(item(),'C'),'43',if(equals(item(),'D'),'44',if(equals(item(),'E'),'45',if(equals(item(),'F'),'46',if(equals(item(),'G'),'47',if(equals(item(),'H'),'48',if(equals(item(),'I'),'49',if(equals(item(),'J'),'4A',if(equals(item(),'K'),'4B',if(equals(item(),'L'),'4C',if(equals(item(),'M'),'4D',if(equals(item(),'N'),'4E',if(equals(item(),'O'),'4F',if(equals(item(),'P'),'50',if(equals(item(),'Q'),'51',if(equals(item(),'R'),'52',if(equals(item(),'S'),'53',if(equals(item(),'T'),'54',if(equals(item(),'U'),'55',if(equals(item(),'V'),'56',if(equals(item(),'W'),'57',if(equals(item(),'X'),'58',if(equals(item(),'Y'),'59',if(equals(item(),'Z'),'5A','3F')))))))))))))))))))))))))))))))))))))"
                  }
                }
              },
              "runAfter": {
                "Set_variable_SearchHex_Reset": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "5304aa79-99db-4129-8f6d-54aaf847d1e3"
              },
              "type": "Foreach"
            },
            "Get_Bearer_Token": {
              "runAfter": {
                "For_each_SearchChar": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f2c861ae-19ed-44a9-a247-209a7e381fb2"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://login.microsoftonline.com/100b3c99-f3e2-4da0-9c8a-b9d345742c36/oauth2/v2.0/token",
                "headers": {
                  "Content-Type": "application/x-www-form-urlencoded"
                },
                "body": "grant_type=client_credentials\n&client_id=6b699286-72e8-4e8a-8e93-ce166f5c22d0\n&client_secret=@{parameters('BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)')}\n&scope=api://b6772340-5812-4132-abf0-74a74e14fac9/.default"
              }
            },
            "Parse_JSON_BearerToken": {
              "runAfter": {
                "Get_Bearer_Token": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "750155a6-6ffd-4658-9c70-f4af45ffc3a7"
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Get_Bearer_Token')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "ext_expires_in": {
                      "type": "integer"
                    },
                    "access_token": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "Set_variable_BearerToken": {
              "runAfter": {
