              },
              "metadata": {
                "operationMetadataId": "03732293-83b2-46fd-a726-6c654dcb5ccf"
              },
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://api.orsted.dk/powerplants/thermal/DNK/', variables('PlantPrefix'), '/serials/search?limit=10000&serialNumber=', variables('SearchHex'))}",
                "headers": {
                  "Authorization": "***REDACTED***",
                  "Content-Type": "application/json",
                  "x-apikey": "***REDACTED***"
                }
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            }
          },
          "runAfter": {
            "Initialize_variable_SearchHex": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "10e7b050-0fe9-41bf-bed3-f82f1ba89fc2"
          },
          "type": "Scope"
        },
        "Initialize_variable_PlantPrefix": {
          "runAfter": {
