                "operationMetadataId": "92253703-e44e-4b58-af70-e79baeb8d358"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "BearerToken",
                "value": "@body('Parse_JSON_BearerToken')?['access_token']"
