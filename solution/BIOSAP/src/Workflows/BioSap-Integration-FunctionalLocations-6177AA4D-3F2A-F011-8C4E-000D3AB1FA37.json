        "Initialize_variable-FlowRunHistoryLink": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "afab2524-54f5-478a-ba84-6e07bcf1a73a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FlowRunHistoryLink",
                "type": "string",
                "value": "<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}\">Link to Run History</a>"
              }
            ]
          }
        },
        "Initialize_variable_BearerToken": {
          "runAfter": {
            "Initialize_variable-FlowRunHistoryLink": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "924fffae-9b58-40fe-9658-651265de3561"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "BearerToken",
                "type": "string"
              }
            ]
          }
        },
        "Try": {
          "actions": {
            "Set_variable_PlantPrefix": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "cb8233c8-a43f-4992-989a-17af6f7dd911"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "PlantPrefix",
                "value": "@if(greaterOrEquals(length(string(triggerBody()?['text'])),3),substring(string(triggerBody()?['text']),0,3),string(triggerBody()?['text']))"
              }
            },
            "Set_variable_SearchRemainder": {
              "runAfter": {
                "Set_variable_PlantPrefix": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "b0afc43e-f5da-4cc4-9b42-4ad5caffd85f"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "SearchRemainder",
                "value": "@toUpper(if(greater(length(string(triggerBody()?['text'])),3),substring(string(triggerBody()?['text']),3,sub(length(string(triggerBody()?['text'])),3)),''))"
              }
            },
            "Set_variable_SearchHex_Reset": {
              "runAfter": {
