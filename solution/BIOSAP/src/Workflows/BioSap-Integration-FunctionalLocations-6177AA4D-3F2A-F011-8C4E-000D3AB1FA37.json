          "actions": {
            "Convert_UTC_time_to_DK_time_zone": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "b1d446ed-e601-4141-82ea-99371b6c6d11"
              },
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@utcNow()",
                "formatString": "G",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "Romance Standard Time"
              }
            }
          },
          "runAfter": {
            "Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "8dbbeab7-f423-4f3b-81f7-794829653c14"
          },
          "type": "Scope"
        },
