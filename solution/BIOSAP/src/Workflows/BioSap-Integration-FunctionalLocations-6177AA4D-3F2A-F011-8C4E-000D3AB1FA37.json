                  "type": "object",
                  "properties": {
                    "functionallocationoutput": {
                      "title": "FunctionalLocationOutput",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Catch": [
              "Succeeded",
