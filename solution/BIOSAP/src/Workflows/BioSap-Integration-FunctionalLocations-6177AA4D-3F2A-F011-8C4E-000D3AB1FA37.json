          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapWOCClientSecret"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "90daf31a-da0a-4fb9-81f7-674b4e8b0816"
