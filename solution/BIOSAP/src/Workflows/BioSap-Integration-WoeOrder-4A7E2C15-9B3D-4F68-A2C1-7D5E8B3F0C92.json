                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Attachments",
                        "value": {
                          "status": "@outputs('Call_attachments')?['statusCode']",
                          "data": "@body('Call_attachments')"
                        }
                      }
                    },
                    "Call_header_text": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@{parameters('BioSap-SapUtility-BaseUrl (orsted_BioSapSapUtilityBaseUrl)')}/descriptions/@{encodeUriComponent(outputs('Compose_object_id'))}/HeaderText",
                        "headers": {
                          "Authorization": "@{concat('Bearer ', body('Get_token_saputility')?['access_token'])}",
                          "x-apikey": "@parameters('BioSap-SapUtility-Test-ApiKey (orsted_BioSapSapUtilityTestApiKey)')",
                          "Accept": "application/json"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      }
                    },
                    "Set_variable_HeaderText": {
                      "runAfter": {
                        "Call_header_text": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "HeaderText",
                        "value": {
                          "status": "@outputs('Call_header_text')?['statusCode']",
                          "data": "@body('Call_header_text')"
                        }
                      }
                    },
                    "Operations_found": {
                      "runAfter": {},
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@outputs('Call_operations')?['statusCode']",
                              200
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "For_each_operation": {
                          "runAfter": {},
                          "type": "Foreach",
                          "foreach": "@body('Call_operations')",
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "actions": {
                            "Compose_operation_object_id": {
                              "runAfter": {},
                              "type": "Compose",
                              "inputs": "@{coalesce(items('For_each_operation')?['objectId'], items('For_each_operation')?['objectNumber'], items('For_each_operation')?['objnr'], '')}"
                            },
                            "Operation_has_object_id": {
                              "runAfter": {
                                "Compose_operation_object_id": [
                                  "Succeeded"
                                ]
                              },
                              "type": "If",
                              "expression": {
                                "and": [
                                  {
                                    "not": {
                                      "equals": [
                                        "@outputs('Compose_operation_object_id')",
                                        ""
                                      ]
                                    }
                                  }
                                ]
                              },
                              "actions": {
                                "Call_operation_text": {
                                  "runAfter": {},
                                  "type": "Http",
                                  "inputs": {
                                    "method": "GET",
                                    "uri": "@{parameters('BioSap-SapUtility-BaseUrl (orsted_BioSapSapUtilityBaseUrl)')}/descriptions/@{encodeUriComponent(outputs('Compose_operation_object_id'))}/OperationText",
                                    "headers": {
                                      "Authorization": "@{concat('Bearer ', body('Get_token_saputility')?['access_token'])}",
                                      "x-apikey": "@parameters('BioSap-SapUtility-Test-ApiKey (orsted_BioSapSapUtilityTestApiKey)')",
                                      "Accept": "application/json"
                                    },
                                    "retryPolicy": {
                                      "type": "none"
                                    }
                                  },
                                  "runtimeConfiguration": {
                                    "secureData": {
                                      "properties": [
                                        "inputs"
                                      ]
                                    }
                                  }
                                },
                                "Append_operation_text": {
                                  "runAfter": {
                                    "Call_operation_text": [
                                      "Succeeded",
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  },
                                  "type": "AppendToArrayVariable",
                                  "inputs": {
                                    "name": "OperationTexts",
                                    "value": {
                                      "objectId": "@outputs('Compose_operation_object_id')",
                                      "operation": "@coalesce(items('For_each_operation')?['operation'], items('For_each_operation')?['operationNumber'], items('For_each_operation')?['activity'], items('For_each_operation')?['vornr'], '')",
                                      "status": "@outputs('Call_operation_text')?['statusCode']",
                                      "data": "@body('Call_operation_text')"
                                    }
                                  }
                                }
                              },
                              "else": {
                                "actions": {}
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Set_variable_Attachments_token_error": {
                        "runAfter": {},
                        "type": "SetVariable",
                        "inputs": {
                          "name": "Attachments",
                          "value": {
                            "status": "@outputs('Get_token_saputility')?['statusCode']",
                            "data": "@{concat('Token for SAP Utility could not be fetched: ', coalesce(body('Get_token_saputility')?['error_description'], body('Get_token_saputility')?['error'], 'no answer'))}"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_variable_Attachments_not_configured": {
                    "runAfter": {},
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Attachments",
                      "value": {
                        "status": "",
                        "data": "SAP Utility is not configured: set Current value on BioSap-SapUtility-Test-ApiKey and BioSap-SapUtility-BaseUrl."
                      }
                    }
                  }
                }
              }
            },
            "Result": {
              "runAfter": {
                "Call_header": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_operations": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_tasklistitems": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_objects": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_status": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_partner": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_activities": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_causes": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "Call_feedback": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ],
                "SapUtility_configured": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ],
                "Inventory_configured": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              },
              "type": "Compose",
              "inputs": {
                "orderNumber": "@{trim(triggerBody()?['text'])}",
                "objectId": "@outputs('Compose_object_id')",
                "maintenanceItem": "@{if(equals(outputs('Call_header')?['statusCode'], 200), coalesce(body('Call_header')?['maintenanceItem'], body('Call_header')?['wapos'], body('Call_header')?['maintenanceItemNumber'], ''), '')}",
                "header": {
                  "status": "@outputs('Call_header')?['statusCode']",
                  "data": "@body('Call_header')"
                },
                "operations": {
                  "status": "@outputs('Call_operations')?['statusCode']",
                  "data": "@body('Call_operations')"
                },
                "tasklistitems": {
                  "status": "@outputs('Call_tasklistitems')?['statusCode']",
                  "data": "@body('Call_tasklistitems')"
                },
                "objects": {
                  "status": "@outputs('Call_objects')?['statusCode']",
                  "data": "@body('Call_objects')"
                },
                "status": {
                  "status": "@outputs('Call_status')?['statusCode']",
                  "data": "@body('Call_status')"
                },
                "partner": {
                  "status": "@outputs('Call_partner')?['statusCode']",
                  "data": "@body('Call_partner')"
                },
                "activities": {
                  "status": "@outputs('Call_activities')?['statusCode']",
                  "data": "@body('Call_activities')"
                },
                "causes": {
                  "status": "@outputs('Call_causes')?['statusCode']",
                  "data": "@body('Call_causes')"
                },
                "feedback": {
                  "status": "@outputs('Call_feedback')?['statusCode']",
                  "data": "@body('Call_feedback')"
                },
                "headerText": "@variables('HeaderText')",
                "attachments": "@variables('Attachments')",
                "movements": "@variables('Movements')",
                "operationTexts": "@variables('OperationTexts')"
              }
            },
            "Respond_result": {
              "runAfter": {
                "Result": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "ok": "@{if(equals(outputs('Call_header')?['statusCode'], 200), 'yes', 'no')}",
                  "status": "@{outputs('Call_header')?['statusCode']}",
                  "message": "@{if(equals(outputs('Call_header')?['statusCode'], 200), '', concat('The API answered ', string(outputs('Call_header')?['statusCode']), ' on the order header.'))}",
                  "result": "@{string(outputs('Result'))}"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "title": "ok",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    },
                    "status": {
                      "title": "status",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    },
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    },
                    "result": {
                      "title": "result",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Respond_token_error": {
                "runAfter": {},
                "type": "Response",
                "kind": "PowerApp",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "ok": "no",
                    "status": "@{outputs('Get_token')?['statusCode']}",
                    "message": "@{concat('Token could not be fetched: ', coalesce(body('Get_token')?['error_description'], body('Get_token')?['error'], 'no answer'))}",
                    "result": ""
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "ok": {
                        "title": "ok",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "status": {
                        "title": "status",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "message": {
                        "title": "message",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      },
                      "result": {
                        "title": "result",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "Stop_token_error": {
                "runAfter": {
                  "Respond_token_error": [
                    "Succeeded"
                  ]
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "TokenError",
                    "message": "Token could not be fetched (status @{outputs('Get_token')?['statusCode']})."
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
