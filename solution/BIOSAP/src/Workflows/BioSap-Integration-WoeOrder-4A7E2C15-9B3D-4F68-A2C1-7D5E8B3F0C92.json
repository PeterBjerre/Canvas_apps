                      "x-ms-dynamically-added": true,
                      "type": "string"
                    },
                    "status": {
                      "title": "status",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    },
                    "message": {
                      "title": "message",
                      "x-ms-dynamically-added": true,
