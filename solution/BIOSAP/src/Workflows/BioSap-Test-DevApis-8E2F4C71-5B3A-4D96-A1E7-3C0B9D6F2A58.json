{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)": {
          "defaultValue": "***REDACTED***",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapWOCClientSecret"
          }
        },
        "BioSap-WOE-Dev-ApiKey (orsted_BioSapWoeDevApiKey)": {
          "defaultValue": "***REDACTED***",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapWoeDevApiKey"
          }
        },
        "BioSap-Inventory-Dev-ApiKey (orsted_BioSapInventoryDevApiKey)": {
          "defaultValue": "***REDACTED***",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapInventoryDevApiKey"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Order number (WOE)",
                  "type": "string",
                  "description": "E.g. 25711067. Empty = the API team's example",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "title": "Plant (inventory)",
                  "type": "string",
                  "description": "E.g. 2806. Empty = the API team's example",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "title": "Material (inventory)",
                  "type": "string",
                  "description": "E.g. 1019. Empty = the API team's example",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": []
            }
          }
        }
      },
      "actions": {
        "Setup": {
          "runAfter": {},
          "type": "Compose",
          "inputs": {
            "tokenUrl": "https://login.microsoftonline.com/100b3c99-f3e2-4da0-9c8a-b9d345742c36/oauth2/v2.0/token",
            "clientId": "6b699286-72e8-4e8a-8e93-ce166f5c22d0",
            "woeScope": "https://Dongenergy.onmicrosoft.com/b6608a78-4d04-462b-a5da-d5488f8b164c/.default",
            "woeBaseUrl": "https://dev.api.orsted.dk/woe/api",
            "inventoryScope": "https://Dongenergy.onmicrosoft.com/70b9b214-2a2b-41ed-a9e2-aa639525d063/.default",
            "inventoryBaseUrl": "https://dev.api.orsted.dk/inventorymanagement",
            "defaultOrder": "25711067",
            "defaultPlant": "2806",
            "defaultMaterial": "1019"
          }
        },
        "Initialize_variable_Order": {
          "runAfter": {
            "Setup": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Order",
                "type": "string",
                "value": "@{if(empty(trim(coalesce(triggerBody()?['text'], ''))), outputs('Setup')?['defaultOrder'], trim(triggerBody()?['text']))}"
              }
            ]
          }
        },
        "Initialize_variable_Plant": {
          "runAfter": {
            "Initialize_variable_Order": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Plant",
                "type": "string",
                "value": "@{if(empty(trim(coalesce(triggerBody()?['text_1'], ''))), outputs('Setup')?['defaultPlant'], trim(triggerBody()?['text_1']))}"
              }
            ]
          }
        },
        "Initialize_variable_Material": {
          "runAfter": {
            "Initialize_variable_Plant": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Material",
                "type": "string",
                "value": "@{if(empty(trim(coalesce(triggerBody()?['text_2'], ''))), outputs('Setup')?['defaultMaterial'], trim(triggerBody()?['text_2']))}"
              }
            ]
          }
        },
        "Initialize_variable_WoeStatus": {
          "runAfter": {
            "Initialize_variable_Material": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "WoeStatus",
                "type": "string",
                "value": "Not run"
              }
            ]
          }
        },
        "Initialize_variable_InventoryStatus": {
          "runAfter": {
            "Initialize_variable_WoeStatus": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "InventoryStatus",
                "type": "string",
                "value": "Not run"
              }
            ]
          }
        },
        "Check_environment_variables": {
          "runAfter": {
            "Initialize_variable_InventoryStatus": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@length(trim(coalesce(parameters('BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)'), '')))",
                  0
                ]
              },
              {
                "contains": [
                  "@parameters('BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)')",
                  "REDACTED"
                ]
              },
              {
                "equals": [
                  "@length(trim(coalesce(parameters('BioSap-WOE-Dev-ApiKey (orsted_BioSapWoeDevApiKey)'), '')))",
                  0
                ]
              },
              {
                "contains": [
                  "@parameters('BioSap-WOE-Dev-ApiKey (orsted_BioSapWoeDevApiKey)')",
                  "REDACTED"
                ]
              },
              {
                "equals": [
                  "@length(trim(coalesce(parameters('BioSap-Inventory-Dev-ApiKey (orsted_BioSapInventoryDevApiKey)'), '')))",
                  0
                ]
              },
              {
                "contains": [
                  "@parameters('BioSap-Inventory-Dev-ApiKey (orsted_BioSapInventoryDevApiKey)')",
                  "REDACTED"
                ]
              }
            ]
          },
          "actions": {
            "Stop_missing_value": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "MissingValue",
                  "message": "Set Current value on BioSap-WOC-Client-Secret, BioSap-WOE-Dev-ApiKey and BioSap-Inventory-Dev-ApiKey (Solutions > BIO SAP > Environment variables)."
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Get_token_Woe": {
          "runAfter": {
            "Check_environment_variables": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{outputs('Setup')?['tokenUrl']}",
            "headers": {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(outputs('Setup')?['clientId'])}&client_secret=@{parameters('BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)')}&scope=@{encodeUriComponent(outputs('Setup')?['woeScope'])}",
            "retryPolicy": {
              "type": "none"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Token_ok_Woe": {
          "runAfter": {
            "Get_token_Woe": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Get_token_Woe')?['statusCode']",
                  200
                ]
              }
            ]
          },
          "actions": {
            "Call_Woe": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{outputs('Setup')?['woeBaseUrl']}/workorders/@{encodeUriComponent(variables('Order'))}/objects",
                "headers": {
                  "Authorization": "@{concat('Bearer ', body('Get_token_Woe')?['access_token'])}",
                  "x-apikey": "@parameters('BioSap-WOE-Dev-ApiKey (orsted_BioSapWoeDevApiKey)')",
                  "Accept": "application/json"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "Response_Woe": {
              "runAfter": {
                "Call_Woe": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Compose",
              "inputs": {
                "order": "@variables('Order')",
                "url": "@{outputs('Setup')?['woeBaseUrl']}/workorders/@{encodeUriComponent(variables('Order'))}/objects",
                "status": "@outputs('Call_Woe')?['statusCode']",
                "svar": "@body('Call_Woe')"
              }
            },
            "Set_WoeStatus": {
              "runAfter": {
                "Response_Woe": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "WoeStatus",
                "value": "API @{outputs('Call_Woe')?['statusCode']}"
              }
            }
          },
          "else": {
            "actions": {
              "Token_error_Woe": {
                "runAfter": {},
                "type": "Compose",
                "inputs": {
                  "status": "@outputs('Get_token_Woe')?['statusCode']",
                  "error": "@body('Get_token_Woe')?['error']",
                  "error_description": "@body('Get_token_Woe')?['error_description']"
                }
              },
              "Set_WoeStatus_token": {
                "runAfter": {
                  "Token_error_Woe": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "WoeStatus",
                  "value": "Token @{outputs('Get_token_Woe')?['statusCode']}"
                }
              }
            }
          }
        },
        "Get_token_Inventory": {
          "runAfter": {
            "Check_environment_variables": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{outputs('Setup')?['tokenUrl']}",
            "headers": {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(outputs('Setup')?['clientId'])}&client_secret=@{parameters('BioSap-WOC-Client-Secret (orsted_BioSapWOCClientSecret)')}&scope=@{encodeUriComponent(outputs('Setup')?['inventoryScope'])}",
            "retryPolicy": {
              "type": "none"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Token_ok_Inventory": {
          "runAfter": {
            "Get_token_Inventory": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Get_token_Inventory')?['statusCode']",
                  200
                ]
              }
            ]
          },
          "actions": {
            "Call_Inventory": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{outputs('Setup')?['inventoryBaseUrl']}/materialonstocks/@{encodeUriComponent(variables('Plant'))}/@{encodeUriComponent(variables('Material'))}",
                "headers": {
                  "Authorization": "@{concat('Bearer ', body('Get_token_Inventory')?['access_token'])}",
                  "x-apikey": "@parameters('BioSap-Inventory-Dev-ApiKey (orsted_BioSapInventoryDevApiKey)')",
                  "Accept": "application/json"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "Response_Inventory": {
              "runAfter": {
                "Call_Inventory": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Compose",
              "inputs": {
                "plant": "@variables('Plant')",
                "material": "@variables('Material')",
                "url": "@{outputs('Setup')?['inventoryBaseUrl']}/materialonstocks/@{encodeUriComponent(variables('Plant'))}/@{encodeUriComponent(variables('Material'))}",
                "status": "@outputs('Call_Inventory')?['statusCode']",
                "svar": "@body('Call_Inventory')"
              }
            },
            "Set_InventoryStatus": {
              "runAfter": {
                "Response_Inventory": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "InventoryStatus",
                "value": "API @{outputs('Call_Inventory')?['statusCode']}"
              }
            }
          },
          "else": {
            "actions": {
              "Token_error_Inventory": {
                "runAfter": {},
                "type": "Compose",
                "inputs": {
                  "status": "@outputs('Get_token_Inventory')?['statusCode']",
                  "error": "@body('Get_token_Inventory')?['error']",
                  "error_description": "@body('Get_token_Inventory')?['error_description']"
                }
              },
              "Set_InventoryStatus_token": {
                "runAfter": {
                  "Token_error_Inventory": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "InventoryStatus",
                  "value": "Token @{outputs('Get_token_Inventory')?['statusCode']}"
                }
              }
            }
          }
        },
        "Both_ok": {
          "runAfter": {
            "Token_ok_Woe": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ],
            "Token_ok_Inventory": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@variables('WoeStatus')",
                  "API 200"
                ]
              },
              {
                "equals": [
                  "@variables('InventoryStatus')",
                  "API 200"
                ]
              }
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Stop_error": {
                "runAfter": {},
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "ApiError",
                    "message": "WOE: @{variables('WoeStatus')}, Inventory: @{variables('InventoryStatus')}. Expected API 200. See Response_* or Token_error_* in the run history."
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
