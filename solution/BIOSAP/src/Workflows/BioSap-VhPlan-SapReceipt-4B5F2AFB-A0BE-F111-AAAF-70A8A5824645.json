{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapSharePointConn"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "orsted_BioSapOutlookConn"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "BioSap-SiteUrl (orsted_BioSapSiteUrl)": {
          "defaultValue": "https://orsted.sharepoint.com/teams/BioSAPDev",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSiteUrl"
          }
        },
        "BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)": {
          "defaultValue": "55c96ba9-52b8-4018-8945-f736b001d6a2",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenancePlans"
          }
        },
        "BioSap-List-MaintenanceItems (orsted_BioSapListMaintenanceItems)": {
          "defaultValue": "d0b2538e-c702-4375-b766-caf342259495",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapListMaintenanceItems"
          }
        },
        "BioSap-SapSystem (orsted_BioSapSapSystem)": {
          "defaultValue": "GQ1",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapSapSystem"
          }
        },
        "BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)": {
          "defaultValue": "pkbje@orsted.com",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapErrorNotifiers"
          }
        },
        "BioSap-MasterDataEmail (orsted_BioSapMasterDataEmail)": {
          "defaultValue": "sapvedligehold@orsted.com",
          "type": "String",
          "metadata": {
            "schemaName": "orsted_BioSapMasterDataEmail"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 10
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Initialize_FlowRunHistoryLink": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FlowRunHistoryLink",
                "type": "string",
                "value": "<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']['name'])}\">Link to Run History</a>"
              }
            ]
          }
        },
        "Try": {
          "actions": {
            "Get_files_(properties_only)": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetFileItems",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                  "table": "f73be489-5b0f-4b2b-a4c7-20c56c446a42",
                  "folderPath": "/SAP-oprettelse/Kvitteringer",
                  "viewScopeOption": "Default",
                  "$top": 5000
                }
              }
            },
            "Receipt_files": {
              "runAfter": {
                "Get_files_(properties_only)": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_files_(properties_only)')?['value']",
                "where": "@and(equals(item()?['{IsFolder}'], false), contains(toLower(item()?['{FilenameWithExtension}']), '.kvittering'), endsWith(toLower(item()?['{FilenameWithExtension}']), '.json'))"
              }
            },
            "Each_receipt": {
              "foreach": "@body('Receipt_files')",
              "actions": {
                "Handle_receipt": {
                  "actions": {
                    "Get_receipt_content": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetFileContent",
                          "connectionName": "shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                          "id": "@items('Each_receipt')?['{Identifier}']"
                        }
                      }
                    },
                    "Receipt": {
                      "runAfter": {
                        "Get_receipt_content": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": "@json(if(empty(body('Get_receipt_content')?['$content']), string(body('Get_receipt_content')), base64ToString(body('Get_receipt_content')?['$content'])))"
                    },
                    "Get_plan": {
                      "runAfter": {
                        "Receipt": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItem",
                          "connectionName": "shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                          "table": "@parameters('BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)')",
                          "id": "@outputs('Receipt')?['planSpId']"
                        }
                      }
                    },
                    "Valid_receipt": {
                      "actions": {
                        "Warning_lines": {
                          "runAfter": {},
                          "type": "Select",
                          "inputs": {
                            "from": "@coalesce(outputs('Receipt')?['warnings'], createArray())",
                            "select": "@replace(replace(replace(replace(replace(trim(string(item())), '\\', '\\\\'), '\"', '\\\"'), decodeUriComponent('%0D'), ''), decodeUriComponent('%0A'), ' '), decodeUriComponent('%09'), ' ')"
                          },
                          "description": "R2-018: receipt warnings (e.g. materials to add in IA06), JSON-escaped, one per line."
                        },
                        "Warnings_json": {
                          "runAfter": {
                            "Warning_lines": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose",
                          "inputs": "@join(body('Warning_lines'), '\\n')"
                        },
                        "Each_item": {
                          "foreach": "@outputs('Receipt')?['items']",
                          "actions": {
                            "Set_item_numbers": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "operationId": "HttpRequest",
                                  "connectionName": "shared_sharepointonline"
                                },
                                "parameters": {
                                  "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                                  "parameters/method": "POST",
                                  "parameters/uri": "_api/web/lists(guid'@{parameters('BioSap-List-MaintenanceItems (orsted_BioSapListMaintenanceItems)')}')/items(@{items('Each_item')?['spId']})",
                                  "parameters/headers": {
                                    "Accept": "application/json;odata=nometadata",
                                    "Content-Type": "application/json;odata=nometadata",
                                    "IF-MATCH": "*",
                                    "X-HTTP-Method": "MERGE"
                                  },
                                  "parameters/body": "{\"SapItemNo\":\"@{items('Each_item')?['sapItemNo']}\",\"TaskListGroup\":\"@{items('Each_item')?['taskListGroup']}\",\"TaskListGroupCounter\":\"@{items('Each_item')?['taskListCounter']}\"}"
                                }
                              }
                            }
                          },
                          "runAfter": {
                            "Warnings_json": [
                              "Succeeded"
                            ]
                          },
                          "type": "Foreach"
                        },
                        "Set_plan_published": {
                          "runAfter": {
                            "Each_item": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "HttpRequest",
                              "connectionName": "shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                              "parameters/method": "POST",
                              "parameters/uri": "_api/web/lists(guid'@{parameters('BioSap-List-MaintenancePlans (orsted_BioSapListMaintenancePlans)')}')/items(@{outputs('Receipt')?['planSpId']})",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata",
                                "IF-MATCH": "*",
                                "X-HTTP-Method": "MERGE"
                              },
                              "parameters/body": "{\"SAPNum\":\"@{outputs('Receipt')?['sapPlanNo']}\",\"Status\":\"Published\",\"SapCreatedOn\":\"@{utcNow()}\",\"SapCreatedBy\":\"@{outputs('Receipt')?['lockedBy']}\",\"SapWarnings\":\"@{outputs('Warnings_json')}\"}"
                            }
                          }
                        },
                        "Move_file_to_Behandlet": {
                          "runAfter": {
                            "Set_plan_published": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "MoveFileAsync",
                              "connectionName": "shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                              "parameters/sourceFileId": "@items('Each_receipt')?['{Identifier}']",
                              "parameters/destinationDataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                              "parameters/destinationFolderPath": "/SAP-oprettelse/Kvitteringer/Behandlet",
                              "parameters/nameConflictBehavior": 2
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Get_plan": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {
                          "Move_file_to_Afvist": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "operationId": "MoveFileAsync",
                                "connectionName": "shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                                "parameters/sourceFileId": "@items('Each_receipt')?['{Identifier}']",
                                "parameters/destinationDataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                                "parameters/destinationFolderPath": "/SAP-oprettelse/Kvitteringer/Afvist",
                                "parameters/nameConflictBehavior": 2
                              }
                            }
                          },
                          "Send_rejected_notification": {
                            "runAfter": {
                              "Move_file_to_Afvist": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                "operationId": "SendEmailV2",
                                "connectionName": "shared_office365"
                              },
                              "parameters": {
                                "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                                "emailMessage/Cc": "@if(contains(createArray('Partial', 'NeedsCheck', 'Failed'), coalesce(outputs('Receipt')?['state'], '')), parameters('BioSap-MasterDataEmail (orsted_BioSapMasterDataEmail)'), '')",
                                "emailMessage/Subject": "Maintenance plan creator: receipt rejected (@{coalesce(outputs('Receipt')?['state'], '-')}) - @{items('Each_receipt')?['{FilenameWithExtension}']}",
                                "emailMessage/Body": "<p style=\"font-family:Segoe UI,Arial,sans-serif;\">The receipt was rejected and moved to Kvitteringer/Afvist. The plan was not changed. Compare the values below to find the check that failed: the receipt must be state Created with a SAP plan number, carry the plan's order GUID and SAP system, and the plan must be Ready for creation in SAP. A file whose name does not end in .kvittering.json is a OneDrive conflict copy (two PCs wrote the same receipt): check in SAP that the plan was not created twice, then delete the copy.</p><table style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;border-collapse:collapse;\"><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">File</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(items('Each_receipt')?['{FilenameWithExtension}'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">State</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['state'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Plan ID</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['planId'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">SAP plan number</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['sapPlanNo'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">SAP system (receipt)</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['sapSystem'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">SAP system (expected)</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(parameters('BioSap-SapSystem (orsted_BioSapSapSystem)'), '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Order GUID (receipt)</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['orderGuid'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Order GUID (plan)</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(body('Get_plan')?['SapOrderGuid'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Plan status</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(body('Get_plan')?['Status']?['Value'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Last error</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(outputs('Receipt')?['lastError'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td style=\"padding:4px 12px 4px 0;color:#6b7b8c;\">Warnings</td><td style=\"padding:4px 0;\">@{replace(replace(replace(string(coalesce(join(coalesce(outputs('Receipt')?['warnings'], createArray()), '; '), '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr></table><p style=\"font-family:Segoe UI,Arial,sans-serif;\">Run history: @{variables('FlowRunHistoryLink')}</p>",
                                "emailMessage/Importance": "Normal"
                              }
                            }
                          }
                        }
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@endsWith(toLower(items('Each_receipt')?['{FilenameWithExtension}']), '.kvittering.json')",
                              true
                            ]
                          },
                          {
                            "equals": [
                              "@outputs('Receipt')?['kind']",
                              "vhplan-sap-receipt"
                            ]
                          },
                          {
                            "equals": [
                              "@outputs('Receipt')?['state']",
                              "Created"
                            ]
                          },
                          {
                            "equals": [
                              "@not(empty(outputs('Receipt')?['sapPlanNo']))",
                              true
                            ]
                          },
                          {
                            "equals": [
                              "@outputs('Receipt')?['orderGuid']",
                              "@body('Get_plan')?['SapOrderGuid']"
                            ]
                          },
                          {
                            "equals": [
                              "@body('Get_plan')?['Status']?['Value']",
                              "Ready for creation in SAP"
                            ]
                          },
                          {
                            "equals": [
                              "@outputs('Receipt')?['sapSystem']",
                              "@parameters('BioSap-SapSystem (orsted_BioSapSapSystem)')"
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {},
                  "type": "Scope"
                },
                "Move_file_to_Afvist_on_error": {
                  "runAfter": {
                    "Handle_receipt": [
                      "TimedOut",
                      "Failed",
                      "Skipped"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "MoveFileAsync",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                      "parameters/sourceFileId": "@items('Each_receipt')?['{Identifier}']",
                      "parameters/destinationDataset": "@parameters('BioSap-SiteUrl (orsted_BioSapSiteUrl)')",
                      "parameters/destinationFolderPath": "/SAP-oprettelse/Kvitteringer/Afvist",
                      "parameters/nameConflictBehavior": 2
                    }
                  }
                },
                "Send_error_notification_on_receipt_failure": {
                  "runAfter": {
                    "Handle_receipt": [
                      "TimedOut",
                      "Failed",
                      "Skipped"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                      "emailMessage/Subject": "Maintenance plan creator: receipt error - @{items('Each_receipt')?['{FilenameWithExtension}']}",
                      "emailMessage/Body": "<p>Error while processing the receipt.</p><p>File: @{items('Each_receipt')?['{FilenameWithExtension}']}</p><p>@{variables('FlowRunHistoryLink')}</p>",
                      "emailMessage/Importance": "Normal"
                    }
                  }
                }
              },
              "runAfter": {
                "Receipt_files": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Initialize_FlowRunHistoryLink": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Catch": {
          "actions": {
            "Send_error_notification": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('BioSap-ErrorNotifiers (orsted_BioSapErrorNotifiers)')",
                  "emailMessage/Subject": "Maintenance plan creator: error in flow @{workflow()?['tags']?['flowDisplayName']}",
                  "emailMessage/Body": "<p>The flow failed. See the run.</p><p>@{variables('FlowRunHistoryLink')}</p>",
                  "emailMessage/Importance": "Normal"
                }
              }
            }
          },
          "runAfter": {
            "Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "type": "Scope"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}